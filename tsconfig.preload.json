{
  // tsconfig.preload.json — type-check-only config for the sandboxed preload
  // bundle. esbuild does the actual emit (`scripts/build-preload.mjs`); this
  // config exists purely so `npm run typecheck` can validate preload against
  // the same `strictTypeChecked` rules as the rest of the project.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "paths": {}
  },
  "include": ["src/preload/**/*.ts", "src/shared/**/*.ts"]
}
